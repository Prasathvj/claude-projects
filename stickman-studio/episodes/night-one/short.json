      "actors": {
        "hero": [{"from": "hero", "do": "stomp_point", "face": "right", "mouth": "talk"}],
        "dog": [{"from": "dog", "do": "sit", "face": "right"}]
      },
      "events": [{"on": "Stay", "fx": "impact", "text": "STAY!"}, {"on": "With", "fx": "impact", "text": "WITH!"},
                 {"on": "The", "fx": "impact", "text": "THE CAR!"}]
    },
    {
      "set": "road",
      "say": "It blocks the wind, and rescuers spot a car way before they spot you.",
