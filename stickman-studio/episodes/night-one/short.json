                 {"on": "spot", "fx": "sticker", "text": "EASY TO SPOT"}]
    },
    {
      "set": "road",
      "say": "But before you run that engine, dig out the exhaust pipe.",
      "direct": "drop lower and serious, slower, a warning",
      "camera": [{"view": "medium"}, {"at": 0.28, "view": "rear", "ease": "snap"}],
      "actors": {
        "hero": [{"from": "rear", "do": "dig", "face": "right"}],
