  "beats": [
    {"text": "This recipe page looks harmless.", "dir": "intriguing, quick hook",
     "v": {"type": "browser", "url": "best-pancakes.example", "title": "Fluffy Pancakes in 10 Minutes", "body": ["2 cups flour", "1 cup milk", "2 eggs, a pinch of salt"], "label": "ILLUSTRATION"}, "trans": "punch", "sfx": ["pop"]},
    {"text": "But hit select all, and there's a hidden message.", "dir": "conspiratorial, faster",
