    {"text": "Written for AI.", "dir": "ominous, short",
     "v": {"type": "slam", "text": "WRITTEN FOR AI", "accent": "hot"}, "trans": "whip", "sfx": ["impact"]},
    {"text": "You ask your AI agent to summarize the page.", "dir": "casual",
